# ============================================================
# ComputeCoin environment configuration
# Copy to .env, then run `make secrets` to fill random secrets.
# ============================================================

# development | staging | production
ENVIRONMENT=development

# JWT signing key. RUN `make secrets` or: openssl rand -hex 32
SECRET_KEY=change-me-run-make-secrets

# ---- Host port mappings (your 8080 is taken by sub2api) ----
APP_HOST_PORT=8788
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# ---- PostgreSQL (used by docker-compose; app connects via DATABASE_URL it sets) ----
POSTGRES_USER=computecoin
POSTGRES_PASSWORD=change-me-run-make-secrets
POSTGRES_DB=computecoin

# ---- Bootstrap admin (created on first startup) ----
ADMIN_EMAIL=admin@computecoin.local
ADMIN_PASSWORD=change-me-admin

# ---- sub2api integration (optional) ----
# If your sub2api runs on the host at :8080, use host.docker.internal from the container:
# SUB2API_BASE_URL=http://host.docker.internal:8080
# SUB2API_ADMIN_TOKEN=

# ---- Compliance ----
# When true, /exchange/orders requires the user's kyc_status == "approved".
REQUIRE_KYC_FOR_TRADING=false

# ---- Local (non-docker) dev only ----
# Leave unset to use SQLite. docker-compose overrides this automatically.
# DATABASE_URL=sqlite+aiosqlite:///./computecoin.db
